void setup() {
  // put your setup code here, to run once:
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.display();
  delay(1000);
  display.clearDisplay();
  display.display();
  pinMode(3, OUTPUT);
  pinMode(4, OUTPUT);
  pinMode(5, OUTPUT);
}

void loop() {
  // put your main code here, to run repeatedly:
  Soundlevel = analogRead(SoundPin);
  Airlevel = analogRead(AirPin);
  Templevel = analogRead(TempPin);
  Wellness == 0;
  if (Soundlevel < 200) {
      digitalWrite(3, HIGH);
      Wellness += 1;
    }
    else {
      digitalWrite(3, LOW);
    }
  if (Airlevel < 400) {
      digitalWrite(4, HIGH);
      Wellness += 1;
    }
    else {
      digitalWrite(4, LOW);
    }
  if (Templevel > 300) {
      digitalWrite(5, HIGH);
      Wellness += 1;
    }
    else {
      digitalWrite(5, LOW);
    }
  if (Wellness == 0) {
    display.clearDisplay();
    display.display();
    display.drawBitmap(0, 0, sad_face, 128, 64, SSD1306_WHITE);
    display.display();
    delay(1000);
    display.clearDisplay();
    display.display();
    display.drawBitmap(0,0, sad_face2, 128, 64, SSD1306_WHITE);
    display.display();
    delay(200);
    }
    else if (Wellness == 1) {
      display.clearDisplay();
      display.display();
      display.drawBitmap(0, 0, meh_face, 128, 64, SSD1306_WHITE);
      display.display();
      delay(1000);
      display.clearDisplay();
      display.display();
      display.drawBitmap(0, 0, meh_face2, 128, 64, SSD1306_WHITE);
      display.display();
      delay(200);
    }
    else if (Wellness == 2) {
      display.clearDisplay();
      display.display();
      display.drawBitmap(0, 0, happy_face, 128, 64, SSD1306_WHITE);
      display.display();
      delay(1000);
      display.clearDisplay();
      display.display();
      display.drawBitmap(0, 0, happy_face2, 128, 64, SSD1306_WHITE);
      display.display();
      delay(200);
    }
    else if (Wellness == 3) {
      display.clearDisplay();
      display.display();
      display.drawBitmap(0, 0, veryhappy_face, 128, 64, SSD1306_WHITE);
      display.display();
      delay(1000);
      display.clearDisplay();
      display.display();
      display.drawBitmap(0, 0, veryhappy_face2, 128, 64, SSD1306_WHITE);
      display.display();
      delay(200);
    }
}