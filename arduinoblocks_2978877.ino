void setup()
{
  pinMode(A0, INPUT);
pinMode(A2, INPUT);
	pinMode(A1, INPUT);
	pinMode(3, OUTPUT);
	pinMode(4, OUTPUT);
	pinMode(5, OUTPUT);

	b_TemperatureAcceptable = false;
	b_TemperatureAcceptable = false;
	b_TemperatureAcceptable = false;
	HappinessScore = 0;

	xTaskCreate(Task_0,"T0",task_stacksize,NULL,1,NULL);
}


void loop()
{

  	if ((((float) map(analogRead(A0),0,1023,0,100)) < 30)) {
  		b_NoiseAcceptable = true;
  	}
  	else {
  		b_NoiseAcceptable = false;
  	}

  	if (((((float) ((analogRead(A2) * ((5.0*100.0)/1023.0)) - 50.0)) > 10) && (((float) ((analogRead(A0) * ((5.0*100.0)/1023.0)) - 50.0)) < 25))) {
  		b_TemperatureAcceptable = true;
  	}
  	else {
  		b_TemperatureAcceptable = false;
  	}

  	if ((((float)map(analogRead(A1),0,1023,0,100)) < 10)) {
  		b_AirAcceptable = true;
  	}
  	else {
  		b_AirAcceptable = false;
  	}

  	HappinessScore = 0;
  	if (b_NoiseAcceptable) {
  		HappinessScore = (HappinessScore + 1);
  		digitalWrite(3, HIGH);
  	}
  	else {
  		digitalWrite(3, LOW);
  	}

  	if (b_TemperatureAcceptable) {
  		HappinessScore = (HappinessScore + 1);
  		digitalWrite(4, HIGH);
  	}
  	else {
  		digitalWrite(4, LOW);
  	}

  	if (b_AirAcceptable) {
  		HappinessScore = (HappinessScore + 1);
  		digitalWrite(5, HIGH);
  	}
  	else {
  		digitalWrite(5, LOW);
  	}

